{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SFL Engine Policy",
  "description": "Central deploy-time engine policy for Set it Free Loop workflow markdown.",
  "type": "object",
  "required": [
    "defaultProfile",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultProfile": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "copilot",
              "claude",
              "codex",
              "gemini",
              "crush",
              "opencode",
              "pi"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "requiredSecretsAnyOf": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "profile"
        ],
        "properties": {
          "profile": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
